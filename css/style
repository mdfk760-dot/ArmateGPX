    /* ===== 路徑排序按鈕切換 ===== */
    .routeModeSwitch{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
    }
    .routeModeOption{display:block;margin:0;cursor:pointer}
    .routeModeOption input{position:absolute;opacity:0;pointer-events:none}
    .routeModeOption span{
      min-height:46px;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:10px 12px;
      border:1px solid var(--line);
      border-radius:14px;
      background:#fff;
      color:var(--muted);
      font-size:14px;
      font-weight:900;
      text-align:center;
      transition:.15s ease;
    }
    .routeModeOption:hover span{transform:translateY(-1px);filter:brightness(.98)}
    .routeModeOption input:checked+span{
      background:var(--pink);
      color:#fff;
      border-color:var(--pink);
      box-shadow:0 5px 14px rgba(239,125,155,.18);
    }

    /* ===== 種花模式切換 ===== */
    .flowerModeSwitch{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:8px;
      margin-bottom:10px;
    }
    .flowerModeOption{
      position:relative;
      display:block;
      margin:0;
      cursor:pointer;
    }
    .flowerModeOption input{
      position:absolute;
      opacity:0;
      pointer-events:none;
    }
    .flowerModeOption span{
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:42px;
      padding:9px 12px;
      border:1px solid var(--line);
      border-radius:13px;
      background:#fff;
      color:var(--muted);
      font-size:13px;
      font-weight:900;
      text-align:center;
      transition:.15s ease;
    }
    .flowerModeOption input:checked+span{
      color:#fff;
      background:var(--pink);
      border-color:var(--pink);
      box-shadow:0 5px 14px rgba(239,125,155,.18);
    }
    .flowerModeDescription{line-height:1.65}
    @media(max-width:560px){
      .flowerModeSwitch{grid-template-columns:1fr}
