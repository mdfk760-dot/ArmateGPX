    /* ===== 手機版寬度與水平溢出修正 ===== */
    html,
    body{
      width:100%;
      max-width:100%;
      overflow-x:hidden;
    }

    *,
    *::before,
    *::after{
      box-sizing:border-box;
    }

    .wrap{
      width:100%;
      max-width:1260px;
      margin-left:auto;
      margin-right:auto;
    }

    .grid,
    .side,
    .controls,
    .subgrid,
    .copyGrid,
    .outputViewer,
    .outputToolbar,
    .outputTypeTabs,
    .outputDirectionTabs,
    .card,
    .smallcard,
    .copyBlock,
    .stats,
    .stat,
    .vizHead,
    .toggleline{
      min-width:0;
      max-width:100%;
    }

    .card,
    .smallcard,
    .copyBlock,
    textarea,
    input,
    select,
    .dragList,
    .canvasWrap,
    .outputViewerBox{
      width:100%;
      max-width:100%;
    }

    .canvasWrap{
      overflow:hidden;
    }

    .canvasWrap canvas{
      display:block;
      width:100%!important;
      max-width:100%!important;
      height:auto;
    }

    .vizHead{
      flex-wrap:wrap;
    }

    .vizHead > h2{
      min-width:0;
      flex:1 1 240px;
    }

    .vizHead > .toggleline{
      flex:0 1 auto;
      justify-content:flex-end;
    }

    .dragItem{
      min-width:0;
      max-width:100%;
    }

    .dragCoord{
      min-width:0;
      max-width:100%;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .outputViewerBox{
      overflow:auto;
      -webkit-overflow-scrolling:touch;
    }

    @media(max-width:980px){
      .wrap{
        width:100%;
        max-width:100%;
        padding:18px 10px 34px;
      }

      .grid,
      .side,
      .subgrid,
      .controls{
        grid-template-columns:minmax(0,1fr);
      }

      .card{
        width:100%;
        max-width:100%;
        padding:15px;
      }

      .title{
        width:100%;
        max-width:100%;
      }

      .copyGrid,
      .outputGrid{
        grid-template-columns:minmax(0,1fr);
      }

      .vizHead{
        align-items:flex-start;
      }

      .vizHead > .toggleline{
        width:100%;
        justify-content:flex-start;
      }

      .canvasWrap canvas{
        min-height:0;
      }

      .dragList{
        overflow-x:hidden;
      }

      .dragItem{
        grid-template-columns:auto auto minmax(0,1fr);
      }

      .dragHandle{
        display:flex;
      }

      .dragCoord{
        white-space:normal;
        overflow-wrap:anywhere;
        word-break:break-word;
      }

      .outputToolbar{
        grid-template-columns:minmax(0,1fr);
      }

      .outputTypeTabs,
      .outputDirectionTabs{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }

      .outputTabBtn{
        min-width:0;
        white-space:normal;
      }

      .backToTop{
        right:max(14px,env(safe-area-inset-right));
        bottom:max(14px,env(safe-area-inset-bottom));
      }
    }

    @media(max-width:430px){
      .wrap{
        padding-left:8px;
        padding-right:8px;
      }

      .card{
        padding:14px;
      }

      .btns.analyze-group{
        gap:7px;
      }

      .btns.analyze-group button{
        min-width:0;
        padding-left:4px!important;
        padding-right:4px!important;
        white-space:normal;
      }

      .routeModeOption span,
      .flowerModeOption span{
        padding-left:5px;
        padding-right:5px;
        font-size:11px;
      }
    }

    /* ===== 路徑視覺化三版本 + 排序/統計同列 ===== */
    .visualModeTabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;width:min(100%,680px);border:0;border-radius:0;overflow:visible;background:transparent;box-shadow:none;margin:0}
    .visualModeBtn{min-width:0!important;min-height:48px!important;padding:11px 20px!important;border:1px solid #efb9c8!important;border-radius:14px!important;background:#fff!important;color:var(--muted)!important;box-shadow:0 2px 7px rgba(112,79,61,.05)!important;font-size:14px!important;font-weight:900!important}
    .visualModeBtn + .visualModeBtn{border-left:1px solid #efb9c8!important}
    .visualModeBtn:first-child,.visualModeBtn:last-child{border-radius:14px!important}
    .visualModeBtn:hover{background:rgba(239,125,155,.08)!important;transform:translateY(-1px)!important}.visualModeBtn.active{background:var(--pink)!important;color:#fff!important;border-color:var(--pink)!important}
    .resultStatsRow{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.55fr);gap:14px;margin-top:14px;align-items:stretch}
    .resultStatsRow>.card{margin-top:0!important;min-width:0}.resultStatsRow .stats{height:100%;align-content:start}
    .visualTools{display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-wrap:wrap}
    .labelModeSwitch{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;min-width:220px;border:1px solid #efb9c8;border-radius:999px;background:#fff;overflow:hidden;box-shadow:0 2px 7px rgba(112,79,61,.05)}
    .labelModeOption{display:block;margin:0;min-width:0;cursor:pointer}
    .labelModeOption input{position:absolute;opacity:0;pointer-events:none}
    .labelModeOption span{display:flex;align-items:center;justify-content:center;min-height:46px;padding:9px 14px;background:#fff;color:var(--muted);font-size:13px;font-weight:900;line-height:1.3;text-align:center;transition:background .15s ease,color .15s ease}
    .labelModeOption:first-child span{border-radius:999px 0 0 999px}
    .labelModeOption:last-child span{border-radius:0 999px 999px 0;border-left:1px solid #efb9c8}
    .labelModeOption:hover span{background:rgba(239,125,155,.08)}
    .labelModeOption input:checked+span{background:var(--pink);color:#fff}
    .labelModeOption input:focus-visible+span{outline:3px solid rgba(239,125,155,.22);outline-offset:-3px}
    #pngBtn{min-width:150px!important;min-height:46px!important;padding:10px 20px!important;background:#f4e4d7!important;color:#6d5142!important;border:1px solid #dfc3ad!important;font-weight:900!important}
    #pngBtn:hover{background:#eed9c8!important;color:#5c4336!important}
    @media(max-width:980px){.resultStatsRow{grid-template-columns:minmax(0,1fr)}.visualModeTabs{width:100%;gap:7px}.visualModeBtn{min-height:44px!important;padding:9px 7px!important;font-size:12px!important}.visualTools{width:100%;justify-content:space-between}.labelModeSwitch{flex:1 1 220px}.visualTools #pngBtn{flex:1 1 150px;min-width:140px!important}}
    @media(max-width:520px){.visualTools{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.labelModeSwitch{width:100%;min-width:0}.labelModeOption span{min-height:44px;padding:8px 6px;font-size:12px}.visualTools #pngBtn{width:100%;min-width:0!important;padding-left:8px!important;padding-right:8px!important}}


    /* ===== 網站新版提醒 ===== */
    .site-update-banner{
      position:fixed;top:14px;left:50%;transform:translateX(-50%) translateY(-18px);
      z-index:100000;width:min(560px,calc(100% - 28px));display:flex;align-items:center;
      justify-content:space-between;gap:12px;padding:12px 14px;border:1px solid var(--line);
      border-radius:18px;background:rgba(255,255,255,.97);box-shadow:0 12px 30px rgba(112,79,61,.16);
      backdrop-filter:blur(10px);opacity:0;visibility:hidden;pointer-events:none;
      transition:opacity .2s ease,transform .2s ease,visibility .2s ease;
    }
    .site-update-banner.active{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0)}
    .site-update-banner-text{min-width:0;line-height:1.45;font-size:14px;font-weight:800;color:var(--text)}
    .site-update-banner button{flex:0 0 auto;width:auto;white-space:nowrap;padding:9px 12px!important;min-height:38px!important;background:var(--green)}
    @media(max-width:560px){
      .site-update-banner{top:10px;align-items:stretch;flex-direction:column;gap:8px}
      .site-update-banner button{width:100%}
    }

