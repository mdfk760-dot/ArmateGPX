    /* ===== 路徑排序／種花模式：膠囊實線切換器 ===== */
    .routeModeSwitch,
    .flowerModeSwitch{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:0;
      padding:4px;
      border:1px solid #efb9c8;
      border-radius:999px;
      background:#fff;
      box-shadow:0 0 0 3px rgba(239,125,155,.08);
      overflow:hidden;
    }

    .routeModeOption,
    .flowerModeOption{
      display:block;
      margin:0;
      cursor:pointer;
      min-width:0;
    }

    .routeModeOption input,
    .flowerModeOption input{
      position:absolute;
      opacity:0;
      pointer-events:none;
    }

    .routeModeOption span,
    .flowerModeOption span{
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:40px;
      padding:9px 12px;
      border:0;
      border-radius:999px;
      background:transparent;
      color:var(--muted);
      font-size:13px;
      font-weight:900;
      line-height:1.3;
      text-align:center;
      box-shadow:none;
      transition:background .15s ease,color .15s ease;
    }

    .routeModeOption:hover span,
    .flowerModeOption:hover span{
      background:rgba(239,125,155,.08);
      filter:none;
      transform:none;
    }

    .routeModeOption input:checked + span,
    .flowerModeOption input:checked + span{
      background:var(--pink);
      color:#fff;
      box-shadow:none;
      transform:none;
    }

    .routeModeOption input:focus-visible + span,
    .flowerModeOption input:focus-visible + span{
      outline:3px solid rgba(239,125,155,.22);
      outline-offset:1px;
    }

